<?xml version="1.0" encoding="utf-8"?>
<mirror-site id="romhustler">
  <name>Mirror for romhustler.org</name>
  <storage type="file"/>
  <advertiser type="web">
    <handler type="httpdir"/>
  </advertiser>
  <advertiser type="ftp"/>
  <initializer>
    <executable>updater.py</executable>
  </initializer>
  <updater>
    <executable>updater.py</executable>
    <schedule type="cronexpr">0 * * * *</schedule>
  </updater>
</mirror-site>
